# Author-aligned Robotwin post-training profile for the current 4xA100 CFFF node.
# Load with:
#   bash script/run_va_posttrain_profile.sh train_profiles/robotwin_author_4gpu.env

# Launcher settings
CONFIG_NAME=robotwin_train
NGPU=4
MASTER_PORT=29501
LOG_RANK=0
TORCHFT_LIGHTHOUSE=http://localhost:29510

# Training inputs on the remote CFFF host
LINGBOT_VA_TRAIN_MODEL_PATH=/home/ct_24210860031/models/lingbot-va-base
LINGBOT_VA_DATASET_PATH=/home/ct_24210860031/812/SYR/datasets/robotwin-clean-and-aug-lerobot
LINGBOT_VA_SAVE_ROOT=./train_out/robotwin_author_4gpu_eqbs8

# Comparison checkpoint for later evaluation only; the trainer does not use it.
LINGBOT_VA_REFERENCE_MODEL_PATH=/mnt/sda/syr/models/lingbot-va-posttrain-robotwin

# Logging defaults
LINGBOT_VA_ENABLE_WANDB=0
WANDB_PROJECT=va_robotwin

# Post-training hyperparameters aligned with the public Robotwin recipe.
LINGBOT_VA_LOAD_WORKERS=16
LINGBOT_VA_SAVE_INTERVAL=10000
LINGBOT_VA_GC_INTERVAL=50
LINGBOT_VA_CFG_PROB=0.1
LINGBOT_VA_LR=1e-5
LINGBOT_VA_WEIGHT_DECAY=0.1
LINGBOT_VA_WARMUP_STEPS=10
LINGBOT_VA_BATCH_SIZE=1
LINGBOT_VA_NUM_STEPS=50000

# The open-source launcher defaults to NGPU=8 with batch_size=1.
# On the current 4-GPU remote node, grad accumulation 2 preserves the same
# effective global batch size of 8 samples per optimizer step.
LINGBOT_VA_GRAD_ACCUM_STEPS=2
